{
  "name": "openclaude",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack -H 127.0.0.1",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint .",
    "desktop": "electron .",
    "desktop:build": "next build && electron .",
    "dist": "next build && electron-builder --win",
    "typecheck": "tsc --noEmit",
    "test": "tsx scripts/check-jail.mjs && tsx scripts/selfcheck.ts"
  },
  "dependencies": {
    "@ai-sdk/mcp": "^2.0.105",
    "@ai-sdk/openai-compatible": "^3.0.95",
    "@ai-sdk/react": "^4.0.187",
    "ai": "^7.0.182",
    "lucide-react": "^1.81.0",
    "next": "15.5.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "main": "electron/main.js",
  "description": "Claude-style agent for any LLM",
  "build": {
    "appId": "dev.openclaude.app",
    "productName": "OpenClaude",
    "directories": {
      "output": "dist-desktop"
    },
    "files": [
      "electron/**",
      ".next/**",
      "!.next/cache/**",
      "app/**",
      "lib/**",
      "public/**",
      "next.config.*",
      "package.json"
    ],
    "asar": false,
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AlbertCJC/openclaude.git"
  },
  "author": "AlbertCJC"
}
